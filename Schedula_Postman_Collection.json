              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"John Doe\",\n  \"age\": 30,\n  \"gender\": \"Male\",\n  \"contactDetails\": \"+1234567890\",\n  \"basicHealthInformation\": \"No known allergies.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/patient/profile",
              "host": ["{{baseUrl}}"],
              "path": ["patient", "profile"]
            }
          }
        },
        {
          "name": "Update Patient Profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"basicHealthInformation\": \"Allergic to peanuts.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/patient/profile",
              "host": ["{{baseUrl}}"],
              "path": ["patient", "profile"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Doctor Availability",
      "item": [
        {
          "name": "Get All Availabilities",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/doctor/availability",
              "host": ["{{baseUrl}}"],
              "path": ["doctor", "availability"]
            }
          }
        },
        {
          "name": "Add Recurring Availability",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dayOfWeek\": 1,\n  \"startTime\": \"09:00\",\n  \"endTime\": \"17:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/doctor/availability",
              "host": ["{{baseUrl}}"],
              "path": ["doctor", "availability"]
            }
          }
        },
        {
          "name": "Add Custom Override",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"specificDate\": \"2024-12-25\",\n  \"startTime\": \"10:00\",\n  \"endTime\": \"14:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/doctor/availability/override",
              "host": ["{{baseUrl}}"],
              "path": ["doctor", "availability", "override"]
            }
          }
        },
        {
          "name": "Get Custom Availability by Date",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/doctor/availability/date?date=2024-12-25",
              "host": ["{{baseUrl}}"],
              "path": ["doctor", "availability", "date"],
              "query": [
                {
                  "key": "date",
                  "value": "2024-12-25"
                }
              ]
            }
          }
        },
        {
          "name": "Update Availability",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dayOfWeek\": 1,\n  \"startTime\": \"10:00\",\n  \"endTime\": \"18:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/doctor/availability/:id",
              "host": ["{{baseUrl}}"],
              "path": ["doctor", "availability", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Availability",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/doctor/availability/:id",
              "host": ["{{baseUrl}}"],
              "path": ["doctor", "availability", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Appointments",
      "item": [
        {
          "name": "Book Appointment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": \"123e4567-e89b-12d3-a456-426614174000\",\n  \"date\": \"2024-10-15\",\n  \"startTime\": \"10:00\",\n  \"endTime\": \"10:30\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/appointment",
              "host": ["{{baseUrl}}"],
              "path": ["appointment"]
            }
          }
        },
        {
          "name": "Reschedule Appointment",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newDate\": \"2024-10-16\",\n  \"newStartTime\": \"14:00\",\n  \"newEndTime\": \"14:30\",\n  \"newSchedulingType\": \"WAVE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/appointment/:id/reschedule",
              "host": ["{{baseUrl}}"],
              "path": ["appointment", ":id", "reschedule"],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Cancel Appointment",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/appointment/:id/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["appointment", ":id", "cancel"],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Get My Appointments (Patient)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/appointment/my",
              "host": ["{{baseUrl}}"],
              "path": ["appointment", "my"]
            }
          }
        },
        {
          "name": "Get Doctor Appointments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/appointment/doctor",
              "host": ["{{baseUrl}}"],
              "path": ["appointment", "doctor"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ]
}
